{
  "expo": {
    "name": "Qasa ERP",
    "slug": "qasa-erp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "iq.qasaerp.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Qasa connects to your Qasa ERP PC on the same Wi-Fi.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSFaceIDUsageDescription": "Qasa can unlock with Face ID when you turn it on in the app lock.",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2A33A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "iq.qasaerp.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC"
      ],
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Qasa uses the camera to scan barcodes and take item photos.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "./plugins/with-lan-cleartext.js",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Qasa can unlock with Face ID when you turn it on in the app lock."
        }
      ]
    ],
    "scheme": "qasa",
    "backgroundColor": "#F4F6F9",
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json",
      "ckb": "./locales/ckb.json"
    }
  }
}
